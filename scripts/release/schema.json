{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wonffice:release-manifest:1",
  "title": "Wonffice release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "product", "source", "workspaceSourcePackages", "artifacts", "evidence", "documents", "prototypeIntegrityNotice"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["development", "release"] },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "packagePath"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "packagePath": { "const": "packages/wonffice-release/package.json" }
      }
    },
    "source": {
      "description": "Git source identity for the code combination represented by this manifest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "tag"],
      "properties": {
        "sha": { "$ref": "#/$defs/commitSha" },
        "tag": { "type": ["string", "null"] }
      }
    },
    "workspaceSourcePackages": {
      "description": "Public workspace package.json source versions included for source-combination traceability. These are not proof that the same versions were published to npm; source.sha identifies the code combination.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "packagePath"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "packagePath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "path", "sha256", "evidenceId"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "file" },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256Hex" },
              "evidenceId": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "component", "environment", "ociManifestDigest", "ociManifestPath", "evidenceId"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "oci-image" },
              "component": { "type": "string", "minLength": 1 },
              "environment": { "enum": ["saas", "internal"] },
              "ociManifestDigest": { "$ref": "#/$defs/ociDigest" },
              "ociManifestPath": { "type": "string", "minLength": 1 },
              "imageTarSha256": { "$ref": "#/$defs/sha256Hex" },
              "evidenceId": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "command", "exitCode", "sourceSha", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "sourceSha": { "$ref": "#/$defs/commitSha" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256Hex" }
        }
      }
    },
    "documents": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "migrations", "upgrades"],
          "properties": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "path", "sha256"],
              "properties": {
                "version": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "#/$defs/sha256Hex" }
              }
            },
            "migrations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "path", "sha256"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "$ref": "#/$defs/sha256Hex" }
                }
              }
            },
            "upgrades": {
              "type": "object",
              "additionalProperties": false,
              "required": ["freshInstall", "fromVersions"],
              "properties": {
                "freshInstall": { "type": "boolean" },
                "fromVersions": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/semver" }
                }
              }
            }
          }
        }
      ]
    },
    "prototypeIntegrityNotice": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256Hex": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ociDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "release" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "source": {
            "type": "object",
            "properties": { "tag": { "type": "string", "pattern": "^wonffice-v" } }
          },
          "artifacts": { "type": "array", "minItems": 1 },
          "evidence": { "type": "array", "minItems": 1 },
          "documents": { "type": "object" }
        }
      }
    }
  ]
}
