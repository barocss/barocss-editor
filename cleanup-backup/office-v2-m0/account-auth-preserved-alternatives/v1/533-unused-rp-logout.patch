+/** Initiates RP logout with form serialization. True means submitted, not confirmed. */
+export async function providerLogoutPost(): Promise<boolean> {
+  const idToken = activeSession?.idToken;
+  clearSession();
+  const epoch = sessionEpoch;
+  let form: HTMLFormElement | undefined;
+  try {
+    sessionStorage.setItem(forcePromptKey, '1');
+    announceLogout();
+    const discovery = await discover();
+    if (epoch !== sessionEpoch || !discovery.end_session_endpoint) return false;
+    const endpoint = new URL(discovery.end_session_endpoint);
+    if (endpoint.username || endpoint.password || endpoint.hash || endpoint.searchParams.has('id_token_hint')) return false;
+    const state = randomValue();
+    const fields: Record<string, string> = {
+      client_id: configuration().clientId,
+      post_logout_redirect_uri: location.origin + '/',
+      state,
+      ...(idToken ? { id_token_hint: idToken } : {}),
+    };
+    form = document.createElement('form');
+    form.method = 'POST';
+    form.action = endpoint.href;
+    form.enctype = 'application/x-www-form-urlencoded';
+    form.target = '_self';
+    form.hidden = true;
+    form.autocomplete = 'off';
+    for (const [name, value] of Object.entries(fields)) {
+      const input = document.createElement('input');
+      input.type = 'hidden';
+      input.name = name;
+      input.value = value;
+      form.append(input);
+    }
+    sessionStorage.setItem(logoutReturnKey, state);
+    document.body.append(form);
+    HTMLFormElement.prototype.submit.call(form);
+    return true;
+  } catch {
+    if (epoch === sessionEpoch) sessionStorage.removeItem(logoutReturnKey);
+    return false;
+  } finally {
+    // Submitted form data is captured synchronously; do not retain token DOM nodes.
+    form?.remove();
+  }
+}
