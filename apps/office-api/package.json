{
  "name": "@barocss/office-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @barocss/office-service build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm build && pnpm start",
    "test": "pnpm build && vitest run",
    "test:postgres": "pnpm build && node test/postgres.integration.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test:operator:oidc": "pnpm build && node test/operator.oidc.integration.mjs"
  },
  "dependencies": {
    "@barocss/office-service": "workspace:^",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
