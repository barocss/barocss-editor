{
  "name": "@barocss/editor-react",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:react": "pnpm run stop:react && pnpm dev -- --host 127.0.0.1 --port 5175",
    "stop:react": "for p in 5173 5174 5175 4173 4174 4175; do lsof -tiTCP:$p -sTCP:LISTEN | xargs -r kill -9 >/dev/null 2>&1 || true; done",
    "preview": "vite preview",
    "build": "vite build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@barocss/datastore": "workspace:*",
    "@barocss/devtool": "workspace:*",
    "@barocss/dsl": "workspace:*",
    "@barocss/editor-core": "workspace:*",
    "@barocss/editor-view-react": "workspace:*",
    "@barocss/extensions": "workspace:*",
    "@barocss/renderer-react": "workspace:*",
    "@barocss/schema": "workspace:*",
    "katex": "^0.16.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
