{
  "name": "@barocss/office-icons",
  "version": "0.1.2",
  "description": "The suite's icons: one drawing per act, so every editor in it points at the same picture",
  "type": "module",
  "main": "./src/index.tsx",
  "module": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "files": [
      "dist"
    ],
    "access": "public"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "lucide-react": "^1.28.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barocss/barocss-editor.git",
    "directory": "packages/office-icons"
  }
}
