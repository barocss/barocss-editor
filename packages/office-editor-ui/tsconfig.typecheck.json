{
  /**
   * Type-checking, including the tests. See a sibling package's copy of this note for
   * why the build's `tsconfig.json` cannot be the one that reads them, and why
   * `exclude` is restated below instead of inherited.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*", "test/**/*", "tests/**/*"],
  "exclude": ["dist", "node_modules"]
}
