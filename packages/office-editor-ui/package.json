{
  "name": "@barocss/office-editor-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@barocss/shared": "workspace:*",
    "@barocss/editor-core": "workspace:*",
    "@barocss/editor-view-dom": "workspace:*",
    "@barocss/math-editor": "^0.8.0",
    "@barocss/office-controls": "workspace:*",
    "@barocss/office-icons": "workspace:*",
    "@barocss/office-ui": "workspace:*",
    "katex": "0.16.28",
    "@barocss/extensions": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@barocss/datastore": "workspace:*",
    "@barocss/office-note": "workspace:*",
    "@barocss/office-site": "workspace:*",
    "@barocss/office-slides": "workspace:*",
    "@barocss/office-word": "workspace:*",
    "@barocss/schema": "workspace:*",
    "@types/katex": "0.16.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.8",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "files": [
      "dist"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barocss/barocss-editor.git",
    "directory": "packages/office-editor-ui"
  }
}
