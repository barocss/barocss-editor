{
  "name": "@barocss/office-word",
  "version": "0.1.2",
  "description": "Word: the word-processor product layer over the Barocss editor engine",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "import": "./src/ui.ts",
      "default": "./src/ui.ts"
    },
    "./ui.css": "./src/ui.css",
    "./workspace": "./src/workspace-adapter.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "import": "./dist/ui.js",
        "default": "./dist/ui.js"
      },
      "./ui.css": "./dist/ui.css",
      "./workspace": {
        "types": "./dist/workspace.d.ts",
        "import": "./dist/workspace.js",
        "default": "./dist/workspace.js"
      }
    },
    "files": [
      "dist"
    ],
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@barocss/datastore": "workspace:*",
    "@barocss/dsl": "workspace:*",
    "@barocss/editor-core": "workspace:*",
    "@barocss/extensions": "workspace:*",
    "@barocss/math-editor": "^0.8.0",
    "@barocss/model": "workspace:*",
    "@barocss/office-canvas": "workspace:*",
    "@barocss/office-controls": "workspace:*",
    "@barocss/office-editor-ui": "workspace:*",
    "@barocss/office-icons": "workspace:*",
    "@barocss/office-text": "workspace:*",
    "@barocss/office-ui": "workspace:*",
    "@barocss/schema": "workspace:*",
    "@barocss/shared": "workspace:*",
    "fflate": "0.8.2",
    "@barocss/editor-view-dom": "workspace:*"
  },
  "devDependencies": {
    "@barocss/conformance": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.1"
  },
  "author": "Barocss Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barocss/barocss-editor.git",
    "directory": "packages/office-word"
  },
  "sideEffects": true
}
