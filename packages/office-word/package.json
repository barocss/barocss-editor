{
  "name": "@barocss/office-word",
  "version": "0.1.0",
  "description": "Word: the word-processor product layer over the Barocss editor engine",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./text.css": "./src/text.css"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./text.css": "./dist/text.css"
    },
    "files": [
      "dist"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@barocss/dsl": "workspace:*",
    "@barocss/editor-core": "workspace:*",
    "@barocss/extensions": "workspace:*",
    "@barocss/model": "workspace:*",
    "@barocss/office-controls": "workspace:*",
    "@barocss/office-icons": "workspace:*",
    "@barocss/schema": "workspace:*",
    "@barocss/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.1",
    "@barocss/conformance": "workspace:*"
  },
  "author": "Barocss Team",
  "license": "MIT"
}
