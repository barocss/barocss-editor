{
  "name": "@barocss/office-note",
  "version": "0.1.0",
  "description": "One written thing: the schema, the kit and the editing session a body of prose needs — a CMS field, and a note on its own",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./view": {
      "types": "./src/note-view.tsx",
      "import": "./src/note-view.tsx",
      "default": "./src/note-view.tsx"
    },
    "./note.css": "./src/note.css"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./view": {
        "types": "./dist/note-view.d.ts",
        "import": "./dist/note-view.js",
        "default": "./dist/note-view.js"
      },
      "./note.css": "./dist/note.css"
    },
    "files": [
      "dist"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@barocss/datastore": "workspace:*",
    "@barocss/dsl": "workspace:*",
    "@barocss/editor-core": "workspace:*",
    "@barocss/editor-view-dom": "workspace:*",
    "@barocss/extensions": "workspace:*",
    "@barocss/model": "workspace:*",
    "@barocss/office-canvas": "workspace:*",
    "@barocss/office-controls": "workspace:*",
    "@barocss/office-editor-ui": "workspace:*",
    "@barocss/office-icons": "workspace:*",
    "@barocss/office-text": "workspace:*",
    "@barocss/office-ui": "workspace:*",
    "@barocss/schema": "workspace:*",
    "@barocss/shared": "workspace:*"
  },
  "devDependencies": {
    "@barocss/office-site": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.1"
  },
  "author": "Barocss Team",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
