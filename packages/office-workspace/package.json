{
  "name": "@barocss/office-workspace",
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.tsx",
    "./style.css": "./src/style.css",
    "./host": "./src/host-ui.tsx"
  },
  "scripts": {
    "test:run": "vitest run",
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@barocss/shared": "workspace:*",
    "@barocss/schema": "workspace:*",
    "@barocss/office-note": "workspace:*",
    "@barocss/office-word": "workspace:*",
    "@barocss/office-slides": "workspace:*",
    "@barocss/office-site": "workspace:*",
    "@barocss/office-ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "import": "./dist/ui.js",
        "default": "./dist/ui.js"
      },
      "./style.css": "./dist/style.css",
      "./host": {
        "types": "./dist/host.d.ts",
        "import": "./dist/host.js",
        "default": "./dist/host.js"
      }
    },
    "files": [
      "dist"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barocss/barocss-editor.git",
    "directory": "packages/office-workspace"
  },
  "sideEffects": true
}
