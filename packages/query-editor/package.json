{
  "name": "@barocss/query-editor",
  "version": "0.1.2",
  "type": "module",
  "description": "Embeddable structured search input with filter chips, suggestions, and a framework-independent query model.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "import": "./src/core.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "import": "./src/react.tsx"
    },
    "./jql": {
      "types": "./src/jql.ts",
      "import": "./src/jql.ts"
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js",
        "default": "./dist/core.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js",
        "default": "./dist/react.js"
      },
      "./jql": {
        "types": "./dist/jql.d.ts",
        "import": "./dist/jql.js",
        "default": "./dist/jql.js"
      },
      "./style.css": "./dist/style.css"
    },
    "module": "./dist/index.js",
    "files": [
      "dist"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barocss/barocss-editor.git",
    "directory": "packages/query-editor"
  },
  "keywords": [
    "search",
    "query",
    "filter",
    "combobox",
    "react"
  ]
}
