{
  "name": "@barocss/office-controls",
  "version": "0.1.1",
  "description": "What a control is, and how it reads a selection — the vocabulary every product's toolbar is declared in",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "files": [
      "dist"
    ],
    "access": "public"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@barocss/editor-core": "workspace:*"
  },
  "devDependencies": {
    "@barocss/office-note": "workspace:*",
    "@barocss/office-site": "workspace:*",
    "@barocss/office-slides": "workspace:*",
    "@barocss/office-word": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barocss/barocss-editor.git",
    "directory": "packages/office-controls"
  }
}
