{
  "name": "@barocss/office-slides",
  "version": "0.1.0",
  "description": "Slides: the presentation product layer over the Barocss editor engine",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "import": "./src/ui.ts",
      "default": "./src/ui.ts"
    },
    "./slides.css": "./src/slides.css",
    "./ui.css": "./src/ui.css"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "import": "./dist/ui.js",
        "default": "./dist/ui.js"
      },
      "./slides.css": "./dist/slides.css",
      "./ui.css": "./dist/ui.css"
    },
    "files": [
      "dist"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@barocss/shared": "workspace:*",
    "@barocss/datastore": "workspace:*",
    "@barocss/dsl": "workspace:*",
    "@barocss/editor-core": "workspace:*",
    "@barocss/editor-view-dom": "workspace:*",
    "@barocss/extensions": "workspace:*",
    "@barocss/model": "workspace:*",
    "@barocss/office-canvas": "workspace:*",
    "@barocss/office-controls": "workspace:*",
    "@barocss/office-editor-ui": "workspace:*",
    "@barocss/office-text": "workspace:*",
    "@barocss/office-ui": "workspace:*",
    "@barocss/renderer-dom": "workspace:*",
    "@barocss/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@barocss/conformance": "workspace:*",
    "@barocss/office-icons": "workspace:*",
    "jsdom": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.1"
  },
  "author": "Barocss Team",
  "license": "MIT"
}
