{
  "name": "barocss-editor",
  "version": "1.0.0",
  "description": "Zero Editor - A powerful document editor with DSL-based rendering",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:office": "pnpm --filter @barocss/office-app dev",
    "build:office": "pnpm --filter @barocss/office-app build",
    "test:e2e:office": "pnpm --filter @barocss/office-app test:e2e",
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "dev:docs": "pnpm --filter @barocss/docs-site dev",
    "build:docs": "pnpm --filter @barocss/docs-site build:demo",
    "dev:site": "pnpm --filter @barocss/editor-test dev",
    "dev:react": "pnpm --filter @barocss/editor-react dev",
    "dev:decorator": "pnpm --filter @barocss/editor-decorator-test dev",
    "test": "pnpm -r test",
    "test:ui": "pnpm --filter @barocss/schema test:ui",
    "test:coverage": "pnpm --filter @barocss/schema test:coverage",
    "test:e2e": "pnpm --filter @barocss/editor-test test:e2e",
    "test:e2e:react": "pnpm --filter @barocss/editor-react test:e2e",
    "lint": "node scripts/lint.mjs",
    "type-check:each": "pnpm -r type-check",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test:e2e:word": "pnpm --filter @barocss/word-app test:e2e",
    "test:e2e:slide": "pnpm --filter @barocss/slide-app test:e2e",
    "test:e2e:site": "pnpm --filter @barocss/site-app test:e2e",
    "type-check:tests": "node scripts/typecheck-tests.mjs",
    "type-check": "node scripts/typecheck-all.mjs",
    "test:checks": "node --test scripts/checks/*.test.mjs",
    "preflight": "pnpm test:checks && pnpm lint && pnpm type-check && pnpm type-check:tests"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@tailwindcss/oxide-darwin-arm64": "^4.3.3",
    "@types/node": "^20.19.24",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.7"
  },
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "@playwright/test": "^1.56.1",
    "playwright": "^1.56.1"
  }
}
